# Copy to .env and adjust. Never commit .env.
FA_DATA_DIR=data
FA_EXPORT_DIR=data/raw
FA_TIMEZONE=Asia/Beirut
# Google Health API sign-in: an OAuth client of type "Desktop app" (see README).
FA_GOOGLE_CLIENT_ID=
FA_GOOGLE_CLIENT_SECRET=
# Database: the default is the Postgres from docker-compose.yml (docker compose up -d db).
# FA_DATABASE_URL=postgresql+psycopg://fitbit_agent:local-dev-only@localhost:5433/fitbit_agent
# The agent's language model (CI uses a scripted fake and needs no key).
FA_OPENAI_API_KEY=
# FA_OPENAI_SMALL_MODEL=gpt-5.4-mini
# FA_OPENAI_LARGE_MODEL=gpt-5.5
# FA_LLM_SPEND_CAP_USD=20
# The router (TypeSafe's Jev); without a key questions are routed by the keyword rule.
FA_TYPESAFE_API_KEY=
# FA_TYPESAFE_MODEL=jev-latest
# Accounts: emails allowed to approve sign-ups (JSON list), and days a device stays signed in.
# FA_ADMIN_EMAILS=["you@example.com"]
# FA_SESSION_DAYS=30
