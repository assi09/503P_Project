# Copy to .env and adjust. Never commit .env.
FA_DATA_DIR=data
FA_EXPORT_DIR=data/raw
FA_TIMEZONE=Asia/Beirut
# Google Health API sign-in: an OAuth client of type "Desktop app" (see README).
FA_GOOGLE_CLIENT_ID=
FA_GOOGLE_CLIENT_SECRET=
# Connecting Google Health from the app: a key that encrypts stored tokens, made with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FA_TOKEN_KEY=
# This server's address (Google sends the browser back to <it>/google/callback) and the app's.
# FA_PUBLIC_URL=http://127.0.0.1:8000
# FA_APP_URL=http://localhost:8081
# Database: the default is the Postgres from docker-compose.yml (docker compose up -d db).
# FA_DATABASE_URL=postgresql+psycopg://fitbit_agent:local-dev-only@localhost:5433/fitbit_agent
# The agent's language model (CI uses a scripted fake and needs no key).
FA_OPENAI_API_KEY=
# FA_OPENAI_SMALL_MODEL=gpt-5.4-mini
# FA_OPENAI_LARGE_MODEL=gpt-5.5
# FA_LLM_SPEND_CAP_USD=20
# Weekly team reports: a model writes the prose (checked; templated otherwise), and its cap.
# FA_TEAM_REPORT_NARRATIVE=false
# FA_TEAM_REPORT_CAP_USD=0.02
# The router (TypeSafe's Jev); without a key questions are routed by the keyword rule.
FA_TYPESAFE_API_KEY=
# FA_TYPESAFE_MODEL=jev-latest
# Accounts: emails allowed to approve sign-ups (JSON list), and days a device stays signed in.
# FA_ADMIN_EMAILS=["you@example.com"]
# FA_SESSION_DAYS=30

# Confirmed Google Health writes stay off until write consent and real validation are ready.
# Turning this on still requires an approved account, the right granted write scope, and a
# version-specific confirmation. Do not enable it just for automated tests.
FA_GOOGLE_WRITES_ENABLED=false
