# Copy to .env and adjust. Never commit .env.
FA_DATA_DIR=data
FA_EXPORT_DIR=data/raw
FA_TIMEZONE=Asia/Beirut
# Google Health API sign-in: an OAuth client of type "Desktop app" (see README).
FA_GOOGLE_CLIENT_ID=
FA_GOOGLE_CLIENT_SECRET=
# Database: the default is the Postgres from docker-compose.yml (docker compose up -d db).
# FA_DATABASE_URL=postgresql+psycopg://fitbit_agent:local-dev-only@localhost:5433/fitbit_agent
